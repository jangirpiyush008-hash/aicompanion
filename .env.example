# Production domain — used for canonical URLs, sitemap, OG images.
NEXT_PUBLIC_SITE_URL=https://aicompanionpartner.com

# Secret Desires affiliate link — every Secret Desires CTA on the site resolves
# from this one env var. The code already has this same URL as a fallback so
# the site works even without .env, but set it here anyway so it's obvious
# what URL the site is monetising against.
NEXT_PUBLIC_SECRET_DESIRES_AFFILIATE_URL=https://secretdesires.ai/create-partner?via=saddam-299148

# IndexNow key — used by `npm run indexnow` to submit URLs to Bing/Yandex/etc.
# The key file must live at https://<host>/<key>.txt on the deployed site.
# Falls back to a baked-in default if not set.
INDEXNOW_KEY=9102d783c8193977a86727ff781de39e

# Google Analytics measurement ID.
# NOTE: currently hard-coded in app/layout.tsx (GA_ID). This env var is a
# placeholder if you decide to make it configurable later.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
